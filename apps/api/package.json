{
    "name": "@reader/api",
    "version": "1.0.0",
    "private": true,
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/androso/reader-monorepo.git",
        "directory": "apps/api"
    },
    "main": "build/index.js",
    "scripts": {
        "predev": "pnpm --filter @reader/contracts --filter @reader/epub --filter @reader/processing --filter @reader/providers build",
        "prebuild": "pnpm --filter @reader/contracts --filter @reader/epub --filter @reader/processing --filter @reader/providers build",
        "pretest": "pnpm --filter @reader/contracts --filter @reader/epub --filter @reader/processing --filter @reader/providers build",
        "dev": "DOTENV_CONFIG_PATH=../../.env ts-node-dev -r dotenv/config --respawn --transpile-only --ignore-watch ../../packages src/index.ts",
        "build": "tsc -p tsconfig.json",
        "start": "DOTENV_CONFIG_PATH=../../.env node -r dotenv/config build/index.js",
        "start:production": "NODE_ENV=production node build/production.js",
        "metadata:backfill": "DOTENV_CONFIG_PATH=../../.env node -r dotenv/config build/metadataBackfill.js",
        "test": "node -e \"const fs=require('node:fs'); const p='../../.tmp/apps-api-test'; try { fs.rmSync(p,{recursive:true,force:true}); } catch {}\" && tsc -p tsconfig.test.json && CODEX_OAUTH_ENABLED=false NODE_PATH=./node_modules:../../packages/processing/node_modules node --test ../../.tmp/apps-api-test/test/*.js",
        "pretest:coverage": "pnpm --filter @reader/contracts --filter @reader/epub --filter @reader/processing --filter @reader/providers build",
        "test:coverage": "node -e \"const fs=require('node:fs'); const p='../../.tmp/apps-api-test'; try { fs.rmSync(p,{recursive:true,force:true}); } catch {}\" && tsc -p tsconfig.test.json && CODEX_OAUTH_ENABLED=false NODE_PATH=./node_modules:../../packages/processing/node_modules c8 --all --allowExternal --src=../../.tmp/apps-api-test/src --include='**/apps-api-test/src/services/**/*.js' --include='**/apps-api-test/src/middleware/**/*.js' --include='**/apps-api-test/src/routes/**/*.js' --include='**/apps-api-test/src/utils/**/*.js' --exclude='**/test/**' --exclude='**/utils/swagger.js' --exclude='**/legacy/**' --reporter=text --reporter=lcov --reports-dir=../../coverage/api --check-coverage --lines=90 --functions=90 --branches=80 node --test --test-concurrency=1 ../../.tmp/apps-api-test/test/*.js"
    },
    "dependencies": {
        "@langfuse/openai": "^5.9.1",
        "@langfuse/otel": "^5.9.1",
        "@langfuse/tracing": "^5.9.1",
        "@opentelemetry/sdk-node": "^0.221.0",
        "@opentelemetry/sdk-trace-base": "^2.10.0",
        "@reader/contracts": "workspace:*",
        "@reader/epub": "workspace:*",
        "@reader/processing": "workspace:*",
        "@reader/providers": "workspace:*",
        "cors": "^2.8.5",
        "dotenv": "^16.4.7",
        "drizzle-orm": "^0.45.2",
        "express": "^4.22.2",
        "google-auth-library": "^10.9.0",
        "jsonwebtoken": "^9.0.3",
        "jszip": "^3.10.1",
        "minisearch": "^7.1.2",
        "multer": "^2.2.0",
        "next": "15.5.21",
        "openai": "^5.23.2",
        "pg": "^8.22.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "swagger-jsdoc": "^6.3.0",
        "swagger-ui-express": "^5.0.1"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^4.17.25",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer": "^2.0.0",
        "@types/node": "^20.19.43",
        "@types/pg": "^8.20.0",
        "@types/swagger-jsdoc": "^6.0.4",
        "@types/swagger-ui-express": "^4.1.8",
        "ts-node": "^10.9.2",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.9.3",
        "c8": "11.0.0"
    }
}
