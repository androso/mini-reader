{
    "name": "@reader/api",
    "version": "1.0.0",
    "private": true,
    "main": "build/index.js",
    "scripts": {
        "predev": "pnpm --filter @reader/jobs --filter @reader/processing --filter @reader/providers build",
        "prebuild": "pnpm --filter @reader/jobs --filter @reader/processing --filter @reader/providers build",
        "pretest": "pnpm --filter @reader/jobs --filter @reader/processing --filter @reader/providers build",
        "dev": "DOTENV_CONFIG_PATH=../../.env ts-node-dev -r dotenv/config --respawn --transpile-only --ignore-watch ../../packages src/index.ts",
        "build": "tsc -p tsconfig.json",
        "start": "DOTENV_CONFIG_PATH=../../.env node -r dotenv/config build/index.js",
        "test": "tsc -p tsconfig.test.json && NODE_PATH=./node_modules:../../packages/processing/node_modules node --test ../../.tmp/apps-api-test/test/*.js"
    },
    "dependencies": {
        "@langfuse/openai": "^5.9.0",
        "@langfuse/otel": "^5.9.0",
        "@langfuse/tracing": "^5.9.0",
        "@neondatabase/serverless": "^0.10.4",
        "@opentelemetry/sdk-node": "^0.219.0",
        "@opentelemetry/sdk-trace-base": "^2.8.0",
        "@reader/jobs": "workspace:*",
        "@reader/processing": "workspace:*",
        "@reader/providers": "workspace:*",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/node": "^22.10.2",
        "cors": "^2.8.5",
        "dotenv": "^16.4.7",
        "drizzle-orm": "^0.38.3",
        "express": "^4.21.2",
        "google-auth-library": "^9.15.0",
        "jsonwebtoken": "^9.0.2",
        "jszip": "^3.10.1",
        "minisearch": "^7.1.2",
        "multer": "^1.4.5-lts.1",
        "openai": "^4.77.0",
        "pg": "^8.21.0",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.1",
        "ts-node": "^10.9.2",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.7.2"
    },
    "devDependencies": {
        "@types/jsonwebtoken": "^9.0.7",
        "@types/multer": "^1.4.12",
        "@types/pg": "^8.20.0",
        "@types/swagger-jsdoc": "^6.0.4",
        "@types/swagger-ui-express": "^4.1.7"
    }
}
