{
    "name": "@reader/api",
    "version": "1.0.0",
    "private": true,
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/androso/reader-monorepo.git",
        "directory": "apps/api"
    },
    "main": "build/index.js",
    "scripts": {
        "predev": "pnpm --filter @reader/processing --filter @reader/providers build",
        "prebuild": "pnpm --filter @reader/processing --filter @reader/providers build",
        "pretest": "pnpm --filter @reader/processing --filter @reader/providers build",
        "dev": "DOTENV_CONFIG_PATH=../../.env ts-node-dev -r dotenv/config --respawn --transpile-only --ignore-watch ../../packages src/index.ts",
        "build": "tsc -p tsconfig.json",
        "start": "DOTENV_CONFIG_PATH=../../.env node -r dotenv/config build/index.js",
        "start:production": "NODE_ENV=production node build/production.js",
        "test": "tsc -p tsconfig.test.json && NODE_PATH=./node_modules:../../packages/processing/node_modules node --test ../../.tmp/apps-api-test/test/*.js"
    },
    "dependencies": {
        "@langfuse/openai": "^5.9.1",
        "@langfuse/otel": "^5.9.1",
        "@langfuse/tracing": "^5.9.1",
        "@opentelemetry/sdk-node": "^0.221.0",
        "@opentelemetry/sdk-trace-base": "^2.10.0",
        "@reader/processing": "workspace:*",
        "@reader/providers": "workspace:*",
        "cors": "^2.8.5",
        "dotenv": "^16.4.7",
        "drizzle-orm": "^0.45.2",
        "express": "^4.22.2",
        "google-auth-library": "^10.9.0",
        "jsonwebtoken": "^9.0.3",
        "jszip": "^3.10.1",
        "minisearch": "^7.1.2",
        "multer": "^2.2.0",
        "next": "15.5.21",
        "openai": "^4.104.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "pg": "^8.22.0",
        "swagger-jsdoc": "^6.3.0",
        "swagger-ui-express": "^5.0.1"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^4.17.25",
        "@types/jsonwebtoken": "^9.0.7",
        "@types/multer": "^2.0.0",
        "@types/node": "^22.10.2",
        "@types/pg": "^8.20.0",
        "@types/swagger-jsdoc": "^6.0.4",
        "@types/swagger-ui-express": "^4.1.7",
        "ts-node": "^10.9.2",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.7.2"
    }
}
