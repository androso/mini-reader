        "type": "git",
        "url": "git+https://github.com/androso/reader-monorepo.git",
        "directory": "apps/web"
    },
    "scripts": {
        "predev": "pnpm --filter @reader/epub build",
        "prebuild": "pnpm --filter @reader/epub build",
        "dev": "next dev --turbopack -p 3001",
        "build": "next build",
        "lint": "next lint",
