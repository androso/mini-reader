{
    "name": "@reader/web",
    "version": "0.1.0",
    "private": true,
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/androso/reader-monorepo.git",
        "directory": "apps/web"
    },
    "scripts": {
        "predev": "pnpm --filter @reader/epub build",
        "prebuild": "pnpm --filter @reader/epub build",
        "dev": "next dev --turbopack -p 3001",
        "build": "next build",
        "lint": "next lint",
        "test": "tsc -p tsconfig.test.json && NODE_PATH=./node_modules:../../packages/epub/node_modules node --test ../../.tmp/apps-web-test/test/*.js",
        "test:epub": "pnpm --filter @reader/epub test",
        "test:coverage": "tsc -p tsconfig.test.json && NODE_PATH=./node_modules:../../packages/epub/node_modules c8 --all --allowExternal --src=../../.tmp/apps-web-test/src --include='**/apps-web-test/src/lib/api.js' --include='**/apps-web-test/src/lib/bookBinary.js' --include='**/apps-web-test/src/lib/bookFileKind.js' --include='**/apps-web-test/src/lib/bookProcessingRetry.js' --include='**/apps-web-test/src/lib/bookReaderRouting.js' --include='**/apps-web-test/src/lib/chapterPullGesture.js' --include='**/apps-web-test/src/lib/chatProvider.js' --include='**/apps-web-test/src/lib/chatSources.js' --include='**/apps-web-test/src/lib/epubChapterProcessing.js' --include='**/apps-web-test/src/lib/epubCoverExtraction.js' --include='**/apps-web-test/src/lib/epubNavigation.js' --include='**/apps-web-test/src/lib/offlineLibrary.js' --include='**/apps-web-test/src/lib/offlineProgress.js' --include='**/apps-web-test/src/lib/offlineStore.js' --include='**/apps-web-test/src/lib/readerNavigationBounds.js' --include='**/apps-web-test/src/hooks/chat/chatInput.js' --include='**/apps-web-test/src/hooks/epubImageVisibility.js' --include='**/apps-web-test/src/hooks/imageObjectUrlRegistry.js' --include='**/apps-web-test/src/components/bookCoverLoading.js' --exclude='**/test/**' --reporter=text --reporter=lcov --reports-dir=../../coverage/web --check-coverage --lines=80 --functions=80 --branches=70 node --test ../../.tmp/apps-web-test/test/*.js",
        "test:e2e": "playwright test"
    },
    "dependencies": {
        "@radix-ui/react-scroll-area": "^1.2.0",
        "@radix-ui/react-slot": "^1.1.0",
        "@react-oauth/google": "^0.12.1",
        "@reader/epub": "workspace:*",
        "@serwist/next": "9.5.12",
        "@tanstack/react-query": "^5.62.8",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "epubjs": "^0.3.93",
        "idb": "8.0.3",
        "jszip": "^3.10.1",
        "katex": "^0.17.0",
        "lucide-react": "^0.468.0",
        "motion": "^11.18.0",
        "next": "15.5.21",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-hot-toast": "^2.4.1",
        "react-markdown": "^10.1.0",
        "rehype-katex": "^7.0.1",
        "remark-math": "^6.0.0",
        "tailwind-merge": "^2.5.5",
        "tailwindcss-animate": "^1.0.7"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "eslint": "^9",
        "eslint-config-next": "15.5.22",
        "fake-indexeddb": "6.2.5",
        "postcss": "^8",
        "prettier": "^3.9.6",
        "serwist": "9.5.12",
        "tailwindcss": "^3.4.1",
        "typescript": "^5",
        "c8": "11.0.0",
        "@playwright/test": "1.62.0"
    }
}
