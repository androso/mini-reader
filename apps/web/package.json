        "@tanstack/react-query": "^5.101.4",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "epubjs": "^0.3.93",
        "jszip": "^3.10.1",
        "katex": "^0.18.1",
        "lucide-react": "^0.468.0",
        "motion": "^11.18.0",
        "next": "15.5.21",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-hot-toast": "^2.4.1",
        "react-markdown": "^10.1.0",
