# API
PORT=3000
# Exact browser origin. Required because unsafe requests with any other Origin
# are rejected. Include the scheme and development port.
FRONTEND_URL=http://localhost:3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reader_dev
JWT_SECRET=
LOG_LEVEL=info

# Auth
# Email/password authentication adds no mailer or credential-specific variables.
# Backend audience for Google ID-token verification. Required in production;
# normally the same value as the web app's NEXT_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
DEV_USER_EMAIL=dev@example.com
DEV_USER_NAME=Dev User

# Book processing
BOOK_PROCESSING_RUNNER_ENABLED=true
BOOK_PROCESSING_MAX_ATTEMPTS=3
BOOK_PROCESSING_POLL_INTERVAL_MS=2000
BOOK_PROCESSING_RETRY_DELAY_MS=5000
BOOK_PROCESSING_STALE_LOCK_MS=900000

# Required for ingestion, semantic retrieval, grounding classification, book-scoped web search, and default book-text chat.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002

# Experimental per-user Codex subscription chat. OPENAI_API_KEY remains required
# for ingestion, semantic retrieval, grounding classification, and book-scoped web search.
# encryption key with `openssl rand -base64 32`. Rotating it without re-encrypting
# existing rows disconnects connected Codex accounts.
CODEX_OAUTH_ENABLED=false
CODEX_CREDENTIAL_ENCRYPTION_KEY=


# Book file storage
# Use local storage for local development. Use s3 in production.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.local-storage

# S3 storage. Required only when STORAGE_DRIVER=s3.
S3_BUCKET_NAME=
S3_ENDPOINT=
S3_REGION=us-east-1

# Optional local AWS SDK credentials. Lightsail production uses scoped S3 keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Langfuse observability. Leave keys empty to disable tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_SAMPLE_RATE=1
LANGFUSE_CAPTURE_CONTENT=metadata
LANGFUSE_MAX_CAPTURE_CHARS=500

# Vector ingestion tuning
VECTOR_STORE_BATCH_SIZE=50
VECTOR_STORE_BATCH_RETRY_ATTEMPTS=4
VECTOR_STORE_BATCH_RETRY_DELAY_MS=1000
