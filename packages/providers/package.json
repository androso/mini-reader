{
    "name": "@reader/providers",
    "version": "0.1.0",
    "private": true,
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/androso/reader-monorepo.git",
        "directory": "packages/providers"
    },
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "test": "tsc -p tsconfig.test.json && NODE_PATH=./node_modules node --test ../../.tmp/packages-providers-test/test/*.js",
        "test:coverage": "tsc -p tsconfig.test.json && c8 --all --allowExternal --src=../../.tmp/packages-providers-test/src --include='**/packages-providers-test/src/**/*.js' --exclude='**/test/**' --reporter=text --reporter=lcov --reports-dir=../../coverage/providers --check-coverage --lines=90 --functions=90 --branches=80 node --test ../../.tmp/packages-providers-test/test/*.js"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1093.0",
        "openai": "^4.104.0",
        "pg": "^8.22.0"
    },
    "devDependencies": {
        "@types/node": "^20.19.43",
        "@types/pg": "^8.20.0",
        "typescript": "^5.9.3",
        "c8": "11.0.0"
    }
}
