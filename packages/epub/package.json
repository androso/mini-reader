{
    "name": "@reader/epub",
    "version": "0.1.0",
    "private": true,
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/androso/reader-monorepo.git",
        "directory": "packages/epub"
    },
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "test": "tsc -p tsconfig.test.json && NODE_PATH=../../apps/api/node_modules:./node_modules node --test ../../.tmp/packages-epub-test/test/*.js",
        "test:coverage": "tsc -p tsconfig.test.json && NODE_PATH=../../apps/api/node_modules:./node_modules c8 --all --allowExternal --src=../../.tmp/packages-epub-test/src --include='**/packages-epub-test/src/**/*.js' --exclude='**/test/**' --exclude='**/types.js' --reporter=text --reporter=lcov --reports-dir=../../coverage/epub --check-coverage --lines=90 --functions=90 --branches=80 node --test ../../.tmp/packages-epub-test/test/*.js"
    },
    "dependencies": {
        "dompurify": "^3.4.11",
        "jsdom": "^25.0.1",
        "jszip": "^3.10.1"
    },
    "devDependencies": {
        "@types/jsdom": "^21.1.7",
        "@types/node": "^20.19.43",
        "typescript": "^5.9.3",
        "c8": "11.0.0"
    }
}
